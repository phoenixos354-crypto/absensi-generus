# ============================================
# COPY FILE INI JADI .env.local
# ============================================

# Google OAuth (dari Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# NextAuth Secret (generate dengan: openssl rand -base64 32)
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Google Sheets
# ID Spreadsheet dari URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# Google Service Account (dari file JSON yang didownload)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----"

# Groq API (untuk generate dalil harian tema "generasi penerus")
# Dapatkan dari https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Midtrans (untuk fitur "Traktir Kopi" QRIS di badge Support Us)
# Ambil Server Key dari dashboard.midtrans.com > Settings > Access Keys
MIDTRANS_SERVER_KEY=your_midtrans_server_key_here
# "true" kalau pakai akun production Midtrans, kosongkan/"false" untuk sandbox
MIDTRANS_IS_PRODUCTION=false
